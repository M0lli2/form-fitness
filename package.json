{
  "name": "form-native",
  "version": "0.3.3",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-project.mjs",
    "ios:prepare": "npx expo prebuild --platform ios && ruby scripts/embed-watch.rb",
    "eas-build-post-install": "node scripts/eas-native-postinstall.cjs"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-dev-client": "~58.0.21",
    "expo-linear-gradient": "~15.0.0",
    "expo-glass-effect": "~0.1.0",
    "expo-blur": "~15.0.0",
    "expo-sqlite": "~16.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-file-system": "~19.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-sharing": "~14.0.0",
    "expo-image-picker": "~17.0.0",
    "expo-haptics": "~15.0.0",
    "expo-notifications": "~58.1.9",
    "expo-modules-core": "~3.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "expo-crypto": "~15.0.0",
    "expo-system-ui": "~6.0.9"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "@types/react": "~19.1.0"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
